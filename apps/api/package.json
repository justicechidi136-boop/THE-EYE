{
  "name": "@the-eye/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "prebuild": "pnpm --filter @the-eye/shared run build",
    "build": "nest build",
    "start": "node --require ./src/preload-env.cjs dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node --require ./src/preload-env.cjs dist/main.js",
    "start:worker": "node --require ./src/preload-env.cjs dist/worker.js",
    "start:worker:dev": "nest start --entryFile worker --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:import:nigeria-geography": "tsx prisma/import-nigeria-reference-data.ts",
    "db:validate:nigeria-geography": "tsx prisma/validate-nigeria-reference-data.ts",
    "db:import:agency-directory": "tsx prisma/import-agency-directory.ts",
    "db:validate:agency-directory": "tsx prisma/validate-agency-directory.ts",
    "db:import:agency-directory:state-wave1": "tsx prisma/import-agency-directory.ts prisma/data/nigeria-state-agencies.wave1-2026-08-31.json",
    "db:validate:agency-directory:state-wave1": "tsx prisma/validate-agency-directory.ts prisma/data/nigeria-state-agencies.wave1-2026-08-31.json",
    "db:import:agency-directory:state-wave2": "tsx prisma/import-agency-directory.ts prisma/data/nigeria-state-agencies.wave2-2026-08-31.json",
    "db:validate:agency-directory:state-wave2": "tsx prisma/validate-agency-directory.ts prisma/data/nigeria-state-agencies.wave2-2026-08-31.json",
    "db:import:agency-directory:national-formations": "tsx prisma/import-agency-directory.ts prisma/data/nigeria-federal-formations.national-2026-08-31.json",
    "db:validate:agency-directory:national-formations": "tsx prisma/validate-agency-directory.ts prisma/data/nigeria-federal-formations.national-2026-08-31.json",
    "db:import:agency-directory:n5-operational": "tsx prisma/import-agency-directory.ts prisma/data/nigeria-state-agencies.n5-operational-2026-08-31.json",
    "db:validate:agency-directory:n5-operational": "tsx prisma/validate-agency-directory.ts prisma/data/nigeria-state-agencies.n5-operational-2026-08-31.json",
    "db:report:agency-directory": "tsx prisma/report-agency-directory.ts",
    "db:report:agency-recommendations": "tsx prisma/report-agency-recommendations.ts",
    "db:create-admin": "tsx prisma/create-admin.ts",
    "seed:staging:test-accounts": "tsx --require ./src/preload-env.cjs prisma/seed-staging-test-accounts.ts",
    "verify:staging:test-accounts": "tsx --require ./src/preload-env.cjs scripts/verify-staging-test-accounts.ts",
    "verify:staging:certification-data": "tsx --require ./src/preload-env.cjs scripts/verify-staging-certification-data.ts",
    "test": "tsx src/test-runner.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.16.0",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@prisma/client": "^6.1.0",
    "@the-eye/shared": "file:../../packages/shared",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.34.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.4.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@livekit/rtc-node": "^0.13.12",
    "@nestjs/cli": "^10.4.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "jest": "^29.7.0",
    "livekit-client": "^2.9.9",
    "prisma": "^6.1.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "ws": "^8.18.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
