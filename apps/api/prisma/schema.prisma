  Offline
  Available
  Busy
  EnRoute
  OnScene
  OutOfService
}

enum IncidentAssignmentStatus {
  Proposed
  Assigned
  Accepted
  Declined
  Expired
  Reassigned
  EnRoute
  Arrived
  InProgress
  Completed
  Cancelled
}

enum DangerZoneStatus {
  PendingVerification
  ActiveCritical
  ActiveHigh
  ActiveModerate
  Contained
  Monitoring
  AllClear
  Expired
  CancelledFalseReport
}

enum SafetyAlertLevel {
  P1Immediate
  P2Serious
  P3Awareness
  P4AllClear
}

enum SafetyAlertState {
  Awareness
  Approaching
  Critical
  InsideDangerZone
  MovingAway
  Clear
}

enum SafetyAlertDeliveryStatus {
  Queued
  Sent
  Delivered
  Failed
  Suppressed
  Expired
}

model User {
  id                        String                     @id @default(uuid()) @db.Uuid
  email                     String?                    @unique
  phone                     String?                    @unique
  passwordHash              String?                    @map("password_hash")
  googleId                  String?                    @unique @map("google_id")
  phoneVerifiedAt           DateTime?                  @map("phone_verified_at") @db.Timestamptz(6)
  status                    UserStatus                 @default(Active)
  isTrustedReporter         Boolean                    @default(false) @map("is_trusted_reporter")
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  profile                   Profile?
  kycRecords                KycRecord[]
  emergencyContacts         EmergencyContact[]
  reportedIncidents         Incident[]                 @relation("IncidentReporter")
  uploadedMedia             IncidentMedia[]            @relation("MediaUploader")
  verifications             IncidentVerification[]
  timelineEvents            IncidentTimeline[]
  statusChanges             IncidentStatusHistory[]    @relation("StatusChangedBy")
  vehicles                  Vehicle[]
  citizenVehicles           CitizenVehicle[]
  stolenVehicleReports      StolenVehicleReport[]
  missingPersonReports      MissingPersonReport[]
  notifications             Notification[]
  pushTokens                UserPushToken[]
  broadcastDeliveries       BroadcastDelivery[]
  broadcastReads            BroadcastRead[]
  broadcastsCreated         Broadcast[]            @relation("BroadcastCitizenCreator")
  broadcastComments         BroadcastComment[]     @relation("BroadcastCommentAuthor")
  broadcastReports          BroadcastReport[]      @relation("BroadcastReportReporter")
  broadcastSightings        BroadcastSighting[]      @relation("BroadcastSightingReporter")
  groupMessages             GroupMessage[]
  smartwatchDevices         SmartwatchDevice[]
  sosEvents                 SosEvent[]
  auditLogs                 AuditLog[]                 @relation("AuditActor")
  trustedReporter           TrustedReporter?
  refreshTokens             RefreshToken[]
  phoneOtps                 PhoneOtp[]
  passwordResetTokens       PasswordResetToken[]
  accountRecoveryChallenges AccountRecoveryChallenge[]
  mediaAccessLogs           IncidentMediaAccessLog[]
  communityMemberships      CommunityMembership[]
  communityPosts            CommunityPost[]
  communityPostMedia        CommunityPostMedia[]
  communityComments         CommunityPostComment[]
  communityReactions        CommunityPostReaction[]
  communityVerifications    CommunityVerification[]
  communityVerificationRequests CommunityVerificationRequest[] @relation("CommunityVerificationTarget")
  communityVerificationResponses CommunityVerificationResponse[] @relation("CommunityVerificationResponder")
  communityMessages         CommunityMessage[]
  communityRequests         CommunityRequest[]
  communityContentReports   CommunityContentReport[]
  communityPresence         CommunityPresence[]
  nwDynamicAreaPresence     NwDynamicAreaPresence[]
  communityAlertsCreated    CommunityAlert[]
  volunteerProfile          VolunteerProfile?
  patrolAssignments         PatrolAssignment[]
  patrolCheckpoints         PatrolCheckpoint[]
  patrolReports             PatrolReport[]
  authAccounts              AuthAccount[]
  responderProfile          Responder?
  deviceGeoStates           DeviceGeoState[]
  safetyAlertRecipients     SafetyAlertRecipient[]
  supportParticipants       SupportConversationParticipant[] @relation("SupportParticipantUser")
  supportMessages           SupportMessage[]               @relation("SupportMessageUser")
  supportConversations      SupportConversation[]          @relation("SupportConversationOwner")
  incidentMessagesSent      IncidentMessage[]              @relation("IncidentMessageSenderUser")
  incidentMessageReceipts   IncidentMessageReceipt[]       @relation("IncidentMessageReceiptUser")

  @@map("users")
}

model AuthAccount {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String
  providerSubject String   @map("provider_subject")
  providerEmail   String?  @map("provider_email")
  emailVerified   Boolean  @default(false) @map("email_verified")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_accounts")
}

model Profile {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @unique @map("user_id") @db.Uuid
  firstName       String     @map("first_name")
  lastName        String     @map("last_name")
  dateOfBirth     DateTime?  @map("date_of_birth") @db.Date
  gender          String?
  address         String?
  country         String
  countryCode     String?    @map("country_code")
  preferredLocale String?    @map("preferred_locale")
  state           String
  lga             String
  avatarUrl       String?    @map("avatar_url")
  homeCommunityId String?    @map("home_community_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeCommunity   Community? @relation("ProfileHomeCommunity", fields: [homeCommunityId], references: [id], onDelete: SetNull)

  @@index([country, state, lga])
  @@index([countryCode])
  @@index([homeCommunityId])
  @@map("profiles")
}

model KycRecord {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  documentType    String    @map("document_type")
  documentNumber  String?   @map("document_number")
  documentHash    String    @map("document_hash")
  status          KycStatus @default(Pending)
  reviewedBy      String?   @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason String?   @map("rejection_reason")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("kyc_records")
}

model EmergencyContact {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String
  phone        String
  relationship String
  priority     Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("emergency_contacts")
}

model Jurisdiction {
  id                 String                                       @id @default(uuid()) @db.Uuid
  country            String
  state              String
  lga                String
  name               String
  boundary           Unsupported("geography(MultiPolygon,4326)")?
  createdAt          DateTime                                     @default(now()) @map("created_at") @db.Timestamptz(6)
  agencies           Agency[]
  adminUsers         AdminUser[]
  policeStations     PoliceStation[]
  broadcasts         Broadcast[]
  incidents          Incident[]
  neighborhoodGroups NeighborhoodGroup[]
  communities        Community[]
  dangerZones        DangerZone[]

  @@unique([country, state, lga])
  @@index([country, state, lga])
  @@map("jurisdictions")
}

model Agency {
  id                       String                                @id @default(uuid()) @db.Uuid
  jurisdictionId           String?                               @map("jurisdiction_id") @db.Uuid
  parentAgencyId           String?                               @map("parent_agency_id") @db.Uuid
  code                     String                                @unique
  name                     String
  shortName                String?                               @map("short_name")
  type                     String
  jurisdictionLevel        String                                @default("LGA") @map("jurisdiction_level")
  countryCode              String                                @default("NG") @map("country_code")
  stateCode                String?                               @map("state_code")
  lgaCode                  String?                               @map("lga_code")
  phone                    String?
  email                    String?
  serviceCategories        String[]                              @default([]) @map("service_categories")
  capabilities             String[]                              @default([])
  isGovernment             Boolean                               @default(true) @map("is_government")
  isEmergencyResponder     Boolean                               @default(true) @map("is_emergency_responder")
  isDispatchable           Boolean                               @default(true) @map("is_dispatchable")
  isFieldOperationsEnabled Boolean                               @default(false) @map("is_field_operations_enabled")
  isDroneEnabled           Boolean                               @default(false) @map("is_drone_enabled")
  isBroadcastAuthority     Boolean                               @default(false) @map("is_broadcast_authority")
  isActive                 Boolean                               @default(true) @map("is_active")
  status                   String                                @default("Active")
  contactMetadata          Json                                  @default("{}") @map("contact_metadata")
  operatingHours           Json                                  @default("{}") @map("operating_hours")
  escalationPriority       Int                                   @default(0) @map("escalation_priority")
  latitude                 Decimal?                              @db.Decimal(9, 6)
  longitude                Decimal?                              @db.Decimal(9, 6)
  agencyLocation           Unsupported("geography(Point,4326)")? @map("agency_location")
  createdAt                DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  jurisdiction             Jurisdiction?                         @relation(fields: [jurisdictionId], references: [id])
  parentAgency             Agency?                               @relation("AgencyHierarchy", fields: [parentAgencyId], references: [id])
  childAgencies            Agency[]                              @relation("AgencyHierarchy")
  adminUsers               AdminUser[]
  incidents                Incident[]
  policeStations           PoliceStation[]
  responders               Responder[]
  responseUnits            ResponseUnit[]
  incidentAssignments      IncidentAssignment[]
  droneOperators           DroneOperator[]
  fieldDevices             FieldDevice[]
  fieldShifts              FieldShift[]
  patrolSessions           PatrolSession[]
  checkpointSessions       CheckpointSession[]
  operationalSightings     OperationalSighting[]
  fieldBackupRequests      FieldBackupRequest[]
  fieldOperationalEvents   FieldOperationalEvent[]
  fieldOfficerSafetyAlerts FieldOfficerSafetyAlert[]

  @@index([jurisdictionId, type])
  @@index([jurisdictionId, isActive])
  @@index([countryCode, stateCode, isActive])
  @@index([type, isActive])
  @@index([parentAgencyId])
  @@map("agencies")
}

model AdminRole {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique
  permissions String[]    @default([])
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  adminUsers  AdminUser[]

  @@map("admin_roles")
}

model AdminUser {
  id                         String                @id @default(uuid()) @db.Uuid
  roleId                     String                @map("role_id") @db.Uuid
  agencyId                   String?               @map("agency_id") @db.Uuid
  jurisdictionId             String                @map("jurisdiction_id") @db.Uuid
  email                      String                @unique
  passwordHash               String                @map("password_hash")
  displayName                String                @map("display_name")
  country                    String
  state                      String
  lga                        String
  isActive                   Boolean               @default(true) @map("is_active")
  createdAt                  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  role                       AdminRole             @relation(fields: [roleId], references: [id])
  agency                     Agency?               @relation(fields: [agencyId], references: [id])
  jurisdiction               Jurisdiction          @relation(fields: [jurisdictionId], references: [id])
  assignedIncidents          Incident[]            @relation("IncidentAssignedAdmin")
  broadcastsCreated          Broadcast[]           @relation("BroadcastCreator")
  broadcastsApproved         Broadcast[]           @relation("BroadcastApprover")
  broadcastsVerified         Broadcast[]           @relation("BroadcastVerifier")
  broadcastComments          BroadcastComment[]    @relation("BroadcastCommentAdmin")
  reports                    Report[]
  auditLogs                  AuditLog[]            @relation("AuditAdminActor")
  refreshTokens              RefreshToken[]
  responderProfile           Responder?
  dispatchAssignmentsCreated IncidentAssignment[]  @relation("AssignmentAssignedBy")
  dispatchEvents             DispatchEvent[]       @relation("DispatchEventActor")
  dangerZonesCreated         DangerZone[]          @relation("DangerZoneCreator")
  dangerZonesReviewed        DangerZone[]          @relation("DangerZoneReviewer")
  allClearEvents             AllClearEvent[]       @relation("AllClearIssuer")
  policyConfigurations       PolicyConfiguration[] @relation("PolicyUpdatedBy")
  preferences                AdminUserPreference?
  droneOperatorProfile       DroneOperator?
  droneMissionsCreated       DroneMission[]        @relation("DroneMissionCreator")
  droneOperatorsSuspended    DroneOperator[]       @relation("DroneOperatorSuspendedBy")
  droneOperatorsReactivated  DroneOperator[]       @relation("DroneOperatorReactivatedBy")
  droneLicencesVerified      DroneOperatorLicence[] @relation("DroneLicenceVerifiedBy")
  droneCertificationsVerified DroneOperatorCertification[] @relation("DroneCertificationVerifiedBy")
  droneQualificationsAssessed DroneOperatorQualification[] @relation("DroneQualificationAssessedBy")
  droneOperatorDocumentsUploaded DroneOperatorDocument[] @relation("DroneOperatorDocumentUploadedBy")
  droneOperatorStatusChanges DroneOperatorStatusHistory[] @relation("DroneOperatorStatusChangedBy")
  droneMissionAssignments    DroneMissionAssignment[] @relation("DroneMissionAssignmentBy")
  dronePreflightOverrides    DroneMissionPreflightCheck[] @relation("DronePreflightOverrideBy")
  droneSafetyRecordsRecorded DroneOperatorSafetyRecord[] @relation("DroneSafetyRecordedBy")
  supportConversationsAssigned SupportConversation[]     @relation("SupportConversationAssignee")
  supportConversationsClosed   SupportConversation[]     @relation("SupportConversationClosedBy")
  supportParticipants          SupportConversationParticipant[] @relation("SupportParticipantAdmin")
  supportMessages              SupportMessage[]          @relation("SupportMessageAdmin")
  incidentMessagesSent         IncidentMessage[]         @relation("IncidentMessageSenderAdmin")
  incidentInformationRequests  IncidentInformationRequest[] @relation("IncidentInformationRequestAdmin")
  assignedFieldDevices         FieldDevice[]              @relation("FieldDeviceAssignedUser")
  approvedFieldDevices         FieldDevice[]              @relation("FieldDeviceApprovedBy")
  revokedFieldDevices          FieldDevice[]              @relation("FieldDeviceRevokedBy")
  provisionedFieldDevices      FieldDevice[]              @relation("FieldDeviceProvisionedBy")
  updatedFieldLauncherPolicies FieldDeviceLauncherPolicy[] @relation("FieldDeviceLauncherPolicyUpdatedBy")
  fieldDeviceSessions          FieldDeviceSession[]       @relation("FieldDeviceSessionAdmin")
  fieldPermissionProfilesCreated  FieldPermissionProfile[] @relation("FieldPermissionProfileCreatedBy")
  fieldPermissionProfilesUpdated  FieldPermissionProfile[] @relation("FieldPermissionProfileUpdatedBy")
  fieldPermissionProfilesDisabled FieldPermissionProfile[] @relation("FieldPermissionProfileDisabledBy")
  fieldDevicePairingTokensIssued    FieldDevicePairingToken[] @relation("FieldDevicePairingTokenIssuedBy")
  fieldDevicePairingTokensCancelled FieldDevicePairingToken[] @relation("FieldDevicePairingTokenCancelledBy")
  fieldShifts                  FieldShift[]               @relation("FieldShiftOfficer")
  fieldShiftsApproved          FieldShift[]               @relation("FieldShiftApprovedBy")
  patrolSessions               PatrolSession[]            @relation("PatrolSessionOfficer")
  checkpointSessions           CheckpointSession[]        @relation("CheckpointSessionOfficer")
  officerStatus                OfficerStatus?
  operationalResponses         OperationalResponse[]      @relation("OperationalResponseOfficer")
  operationalSightings         OperationalSighting[]      @relation("OperationalSightingOfficer")
  fieldBackupRequests          FieldBackupRequest[]       @relation("FieldBackupRequestOfficer")
  fieldOfficerSafetyAlerts     FieldOfficerSafetyAlert[]  @relation("FieldOfficerSafetyAlertOfficer")
  fieldPatrolEvents            FieldPatrolEvent[]         @relation("FieldPatrolEventOfficer")
  fieldCheckpointObservations  FieldCheckpointObservation[] @relation("FieldCheckpointObservationOfficer")

  @@index([country, state, lga])
  @@index([jurisdictionId])
  @@map("admin_users")
}

model Incident {
  id                       String                                @id @default(uuid()) @db.Uuid
  reporterId               String?                               @map("reporter_id") @db.Uuid
  jurisdictionId           String                                @map("jurisdiction_id") @db.Uuid
  assignedAgencyId         String?                               @map("assigned_agency_id") @db.Uuid
  assignedAdminId          String?                               @map("assigned_admin_id") @db.Uuid
  type                     IncidentType
  status                   IncidentStatus                        @default(Submitted)
  priority                 IncidentPriority                      @default(P4GeneralSafety)
  title                    String
  description              String?
  address                  String?
  country                  String
  state                    String
  lga                      String
  latitude                 Decimal?                              @db.Decimal(9, 6)
  longitude                Decimal?                              @db.Decimal(9, 6)
  gpsLocation              Unsupported("geography(Point,4326)")? @map("gps_location")
  manualLatitude           Decimal?                              @map("manual_latitude") @db.Decimal(9, 6)
  manualLongitude          Decimal?                              @map("manual_longitude") @db.Decimal(9, 6)
  manualGpsLocation        Unsupported("geography(Point,4326)")? @map("manual_gps_location")
  manualAddress            String?                               @map("manual_address")
  manualLocationAdjusted   Boolean                               @default(false) @map("manual_location_adjusted")
  isAnonymous              Boolean                               @default(false) @map("is_anonymous")
  notifyEmergencyContacts  Boolean                               @default(false) @map("notify_emergency_contacts")
  clientSubmissionId       String?                               @unique @map("client_submission_id")
  occurredAt               DateTime?                             @map("occurred_at") @db.Timestamptz(6)
  submittedAt              DateTime                              @default(now()) @map("submitted_at") @db.Timestamptz(6)
  metadata                 Json                                  @default("{}")
  createdAt                DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt               DateTime?                             @map("resolved_at") @db.Timestamptz(6)
  closedAt                 DateTime?                             @map("closed_at") @db.Timestamptz(6)
  resolutionSource         ResolutionSource?                     @map("resolution_source")
  resolvedById             String?                               @map("resolved_by_id") @db.Uuid
  resolutionReason         String?                               @map("resolution_reason")
  cancellationRequestedAt  DateTime?                             @map("cancellation_requested_at") @db.Timestamptz(6)
  cancellationRequestedById String?                              @map("cancellation_requested_by_id") @db.Uuid
  cancellationReason       String?                               @map("cancellation_reason")
  cancelledAt              DateTime?                             @map("cancelled_at") @db.Timestamptz(6)
  cancelledById            String?                               @map("cancelled_by_id") @db.Uuid
  statusVersion            Int                                   @default(1) @map("status_version")
  lastTrustedUpdateAt      DateTime?                             @map("last_trusted_update_at") @db.Timestamptz(6)
  closureReviewAt          DateTime?                             @map("closure_review_at") @db.Timestamptz(6)
  liveLocationUpdatedAt    DateTime?                             @map("live_location_updated_at") @db.Timestamptz(6)
  liveLocationStale        Boolean                               @default(false) @map("live_location_stale")
  reporter                 User?                                 @relation("IncidentReporter", fields: [reporterId], references: [id])
  jurisdiction             Jurisdiction                          @relation(fields: [jurisdictionId], references: [id])
  assignedAgency           Agency?                               @relation(fields: [assignedAgencyId], references: [id])
  assignedAdmin            AdminUser?                            @relation("IncidentAssignedAdmin", fields: [assignedAdminId], references: [id])
  media                    IncidentMedia[]
  verifications            IncidentVerification[]
  timeline                 IncidentTimeline[]
  statusHistory            IncidentStatusHistory[]
  locationUpdates          IncidentLocationUpdate[]
  notifications            Notification[]
  liveVideoSessions        LiveVideoSession[]
  liveVideoLocationUpdates LiveVideoLocationUpdate[]
  sosEvents                SosEvent[]
  reports                  Report[]
  broadcasts               Broadcast[]
  communityPosts           CommunityPost[]
