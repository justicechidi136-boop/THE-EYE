generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

enum UserStatus {
  Active
  Suspended
  Deactivated
}

enum KycStatus {
  Pending
  Verified
  Rejected
  Expired
}

enum IncidentStatus {
  Submitted
  Received
  Verifying
  Verified
  Assigned
  Responding
  UnderControl
  CancellationRequested
  Resolved
  Closed
  FalseReport
  CancelledByReporter
  ExpiredAfterReview
}

enum ResolutionSource {
  Agency
  Dispatcher
  Administrator
  Reporter
  Community
  SystemReview
}

enum IncidentPriority {
  P1LifeThreatening
  P2ActiveCrimeAccident
  P3SuspiciousActivity
  P4GeneralSafety
}

enum IncidentType {
  Emergency
  Crime
  Accident
  Fire
  Medical
  CommunitySafety
  Kidnapping
  Abuse
  SuspiciousActivity
  MissingPerson
  StolenVehicle
  SOS
}

enum MediaType {
  Image
  Video
  Audio
  Document
  LiveVideoRecording
}

enum VoiceTranscriptionStatus {
  Uploaded
  Queued
  Processing
  Completed
  LowConfidence
  Failed
}

enum VoiceModerationStatus {
  Pending
  Approved
  Flagged
  Rejected
}

enum BroadcastStatus {
  Draft
  PendingApproval
  Scheduled
  DispatchQueued
  Dispatching
  Published
  Active
  Updated
  Resolved
  Suspended
  DeletedByAdmin
  WithdrawnByAuthor
  Failed
  Expired
  Cancelled
  Rejected
}

enum BroadcastAuthorType {
  Citizen
  Admin
}

enum BroadcastType {
  Emergency
  Crime
  Accident
  MissingPerson
  StolenVehicle
  GovernmentAlert
  CommunityWarning
}

enum BroadcastDeliveryStatus {
  Queued
  Sent
  Delivered
  Failed
  Read
}

enum CommunityLevel {
  Country
  State
  LGA
  Ward
  Community
  Estate
  Street
}

enum CommunityVisibility {
  Public
  Private
}

enum CommunityStatus {
  Active
  Archived
  Suspended
}

enum CommunityRequestStatus {
  Pending
  Approved
  Rejected
}

enum CommunityReportTargetType {
  Post
  Comment
  Member
  Community
}

enum CommunityReportStatus {
  Pending
  Reviewed
  Dismissed
}

enum CommunityMembershipStatus {
  Pending
  Approved
  Rejected
  Left
  Suspended
  Banned
}

enum CommunityRoleName {
  CommunityModerator
  EstateAdmin
  SecurityCoordinator
  PoliceLiaison
  VolunteerCoordinator
  VerifiedVolunteer
  Resident
}

enum CommunityPostType {
  SuspiciousActivity
  LostChild
  MissingPerson
  CrimeAlert
  AccidentAlert
  FireAlert
  FloodWarning
  CommunityAnnouncement
  SecurityMeeting
  PatrolUpdate
  SafetyTip
  Discussion
  LocalWarning
  RoadHazard
  CommunityQuestion
}

enum CommunityPostTargetType {
  COMMUNITY
  DYNAMIC_AREA
}

enum CommunityHazardStatus {
  Open
  Verified
  Ongoing
  Resolved
  Dismissed
}

enum CommunityAlertAudience {
  EntireCommunity
  SelectedZone
  Radius500m
  Radius1km
  WatchTeamOnly
}

enum CommunityAlertStatus {
  Draft
  Active
  Expired
  Cancelled
}

enum CommunityPresenceMode {
  LocationParticipant
  HomePreference
}

enum CommunityVerificationStatus {
  PendingVerification
  Verified
  Disputed
  FalseInformation
}

enum CommunityVerificationRequestStatus {
  Pending
  Delivered
  Opened
  Responded
  Skipped
  Expired
  Revoked
  Cancelled
}

enum CommunityVerificationResponseType {
  Confirmed
  NotFound
  StillOngoing
  AppearsResolved
  UnsafeToVerify
  Skipped
  Unsure
}

enum CommunityVerificationConfidenceLevel {
  High
  Medium
  Low
}

enum CommunityVerificationDistanceBand {
  WITHIN_100_M
  WITHIN_250_M
  WITHIN_500_M
  WITHIN_1_KM
  BEYOND_1_KM
}

enum CommunityReactionType {
  Confirm
  Helpful
  Praying
  Dispute
  Seen
}

enum CommunityChannelType {
  General
  Emergency
  Security
  Volunteers
  WomenSafety
  Parents
  BusinessOwners
}

enum VolunteerType {
  Doctor
  Nurse
  FirstAid
  Lawyer
  SecurityVolunteer
  FireVolunteer
  SearchAndRescue
  BloodDonor
}

enum PatrolStatus {
  Scheduled
  Active
  Paused
  Completed
  Cancelled
}

enum NotificationStatus {
  Pending
  Sent
  Delivered
  Failed
  Read
}

enum ReportStatus {
  Draft
  Generated
  Reviewed
  Published
  Archived
}

enum EscalationStatus {
  Pending
  Notified
  Acknowledged
  Resolved
  Cancelled
}

enum ResponderAvailability {
  Offline
  Available
  Busy
  EnRoute
  OnScene
  OutOfService
}

