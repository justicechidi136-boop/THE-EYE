  checkpointSessionId String                       @map("checkpoint_session_id") @db.Uuid
  officerId           String                       @map("officer_id") @db.Uuid
  observationType     FieldCheckpointObservationType @map("observation_type")
  searchQuery         String?                      @map("search_query")
  matchBroadcastId    String?                      @map("match_broadcast_id") @db.Uuid
  latitude            Decimal?                     @db.Decimal(9, 6)
  longitude           Decimal?                     @db.Decimal(9, 6)
  evidenceReference   String?                      @map("evidence_reference")
  clientActionId      String?                      @unique @map("client_action_id")
  metadata            Json                         @default("{}")
  createdAt           DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  checkpointSession   CheckpointSession            @relation(fields: [checkpointSessionId], references: [id], onDelete: Cascade)
  officer             AdminUser                    @relation("FieldCheckpointObservationOfficer", fields: [officerId], references: [id])
  matchBroadcast      Broadcast?                   @relation(fields: [matchBroadcastId], references: [id])

  @@index([checkpointSessionId, createdAt])
  @@index([officerId, createdAt])
  @@map("field_checkpoint_observations")
}

model FieldDeviceSyncState {
  fieldDeviceId        String      @id @map("field_device_id") @db.Uuid
  officerId            String      @map("officer_id") @db.Uuid
  syncCursor           String?     @map("sync_cursor")
  generationId         String      @map("generation_id")
  lastEventSequence    BigInt      @default(0) @map("last_event_sequence")
  offlineQueueDepth    Int         @default(0) @map("offline_queue_depth")
  deadLetterCount      Int         @default(0) @map("dead_letter_count")
  lastSyncAt           DateTime?   @map("last_sync_at") @db.Timestamptz(6)
  metadata             Json        @default("{}")
  updatedAt            DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  fieldDevice          FieldDevice @relation(fields: [fieldDeviceId], references: [id], onDelete: Cascade)

  @@index([officerId])
  @@map("field_device_sync_states")
}
