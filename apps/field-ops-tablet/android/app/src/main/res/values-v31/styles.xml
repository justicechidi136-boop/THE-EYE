<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash — continuous with Flutter Field Ops init screen -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/field_ops_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/field_ops_splash_background</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/field_ops_splash_background</item>
        <item name="android:navigationBarColor">@color/field_ops_splash_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/field_ops_splash_background</item>
        <item name="android:statusBarColor">@color/field_ops_splash_background</item>
        <item name="android:navigationBarColor">@color/field_ops_splash_background</item>
    </style>
</resources>
