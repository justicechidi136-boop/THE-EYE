<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/field_ops_splash_background</item>
        <item name="android:navigationBarColor">@color/field_ops_splash_background</item>
    </style>
    <!-- Theme applied after process start / behind Flutter UI -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/field_ops_splash_background</item>
        <item name="android:statusBarColor">@color/field_ops_splash_background</item>
        <item name="android:navigationBarColor">@color/field_ops_splash_background</item>
    </style>
</resources>
